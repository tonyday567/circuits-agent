cabal-version: 3.0
name: circuits-agent
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-agent
bug-reports: https://github.com/tonyday567/circuits-agent/issues
synopsis: Moore agents on a shared log; opaque shards for effects.
description:
  Core agent model for the circuits ecosystem: a shared append-only log of
  addressed 'Post's.  Pure agents are Moore machines
  ('Agent' s = 'System' s ('Mono' ['Post'] 'Post')).  Effectful boundaries
  are opaque shards: 'Shard' m = 'Ends' ('Kleisli' m) ['Post'] ['Post']
  (lists both ways; one-post commit via prefixIn (:[])).  'LogEnds' is the
  same shape on the log seat.  Includes process-port plumbing
  ('Circuit.Agent.Process'), message framing ('Circuit.Agent.Framing'),
  and turn-boundary runners ('Circuit.Agent.Turn').

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-agent

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc2024-stanza
  if impl(ghc >=9.10)
    default-language:
      GHC2024
  else
    default-language:
      GHC2021

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Circuit.Agent
    Circuit.Agent.Delivery
    Circuit.Agent.Framing
    Circuit.Agent.Population
    Circuit.Agent.Process
    Circuit.Agent.Turn
    Cursor

  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.4,
    circuits-poly >=0.1 && <0.2,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    harpie >=0.3 && <0.4,
    harpie-numhask >=0.2 && <0.3,
    numhask >=0.14 && <0.15,
    posix-pty >=0.2 && <0.3,
    process >=1.6 && <1.7,
    text >=2.0 && <3,
    time >=1.12 && <2,
    unix >=2.8 && <2.9,
    vector >=0.13 && <0.14,

executable circuits-agent-verify
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: verify.hs
  build-depends:
    base >=4.18 && <5,
    circuits >=0.3 && <0.4,
    circuits-agent,
    circuits-poly,
    harpie >=0.3 && <0.4,
    harpie-numhask >=0.2 && <0.3,
    mtl >=2.3 && <2.4,
    numhask >=0.14 && <0.15,
    text >=2.0 && <3,

  default-language: GHC2024
