cabal-version: 3.0
name: circuits-agent
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-agent
bug-reports: https://github.com/tonyday567/circuits-agent/issues
synopsis: Moore agents on a shared log; opaque shards for effects.
description:
  Core agent model for the circuits ecosystem: a shared append-only log of
  addressed 'Post's.  Agents are Moore machines polymorphic in the base arrow
  ('Agent' arr s a b = 'System' arr s ('Mono' a b)).  The pure case is
  @arr = '(->)'@; the effectful case is @arr = 'Kleisli' m@.  Effectful
  boundaries are opaque shards: 'Shard' m a b = 'Ends' ('Kleisli' m) a b
  (lists both ways in the common log case; one-post commit via prefixIn (:[])).
  'LogEnds' is the same shape on the log seat.  Includes process-port plumbing
  ('Circuit.Agent.StdPorts'), message framing ('Circuit.Agent.Framing'),
  and turn-boundary runners ('Circuit.Agent.Turn').

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-agent

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc2024-stanza
  if impl(ghc >=9.10)
    default-language:
      GHC2024
  else
    default-language:
      GHC2021

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  default-extensions: PackageImports
  exposed-modules:
    Circuit.Agent
    Circuit.Agent.Ends
    Circuit.Agent.Query
    Circuit.Agent.Delivery
    Circuit.Agent.Framing
    Circuit.Agent.Graph
    Circuit.Agent.Machina.Mark
    Circuit.Agent.Mark
    Circuit.Agent.StdPorts
    Circuit.Agent.Tensor
    Circuit.Agent.Turn
    Cursor

  build-depends:
    algebraic-graphs >=0.7 && <0.9,
    async >=2.2 && <2.3,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    circuits >=0.3 && <0.5,
    circuits-mat >=0.1 && <0.2,
    circuits-parser >=0.1 && <0.2,
    string-diagrams >=0.1 && <0.2,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    harpie >=0.3 && <0.4,
    mtl >=2.3 && <2.4,
    numhask >=0.14 && <0.15,
    process >=1.6 && <1.7,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    text >=2.0 && <3,
    time >=1.12 && <2,
    vector >=0.13 && <0.14,

executable circuits-agent-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    algebraic-graphs >=0.7 && <0.9,
    async >=2.2 && <2.3,
    base >=4.18 && <5,
    circuits >=0.3 && <0.5,
    circuits-agent,
    circuits-mat,
    containers >=0.6 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    string-diagrams,
    harpie >=0.3 && <0.4,
    mtl >=2.3 && <2.4,
    numhask >=0.14 && <0.15,
    stm >=2.5 && <2.6,
    text >=2.0 && <3,

  default-language: GHC2024

executable circuits-agent-tape-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: tape-axioma.hs
  build-depends:
    base >=4.18 && <5,
    circuits-agent,
    containers >=0.6 && <0.9,
    circuits-diff >=0.1 && <0.2,
    text >=2.0 && <3,

  default-language: GHC2024

executable circuits-agent-graph-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: graph-axioma.hs
  build-depends:
    algebraic-graphs >=0.7 && <0.9,
    base >=4.18 && <5,
    circuits-agent,
    containers >=0.6 && <0.9,
    text >=2.0 && <3,
    QuickCheck >=2.14 && <2.16,

  default-language: GHC2024
